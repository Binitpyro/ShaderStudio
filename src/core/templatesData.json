      "  let drift = vec2<f32>(uniforms.u_time * 0.02, uniforms.u_time * 0.015);",
      "  let n1 = fbm(uv + drift);",
      "  let n2 = fbm(uv * 1.5 - drift + n1 * 1.2);",
      "",
      "  var color = mix(uniforms.u_nebulaColorA * n1, uniforms.u_nebulaColorB * n2, n2 * uniforms.u_density);",
      "",
      "  // Starfield generation",
      "  let starGrid = fract(uv * 15.0) - 0.5;",
      "  let starId = floor(uv * 15.0);",
      "  let starRand = hash(starId);",
      "  if (starRand > 0.88) {",
      "    let twinkle = sin(uniforms.u_time * 5.0 + starRand * 100.0) * 0.5 + 0.5;",
      "    let starDist = length(starGrid);",
      "    color = color + vec3<f32>(0.04 / (starDist + 0.05)) * twinkle;",
      "  }",
      "",
      "  return vec4<f32>(color, 1.0);",
      "}"
    ],
    "uniforms": {
      "u_nebulaColorA": { "type": "color", "value": [0.6, 0.1, 0.9] },
      "u_nebulaColorB": { "type": "color", "value": [0.1, 0.7, 0.9] },
      "u_density": { "type": "float", "value": 1.4 }
    },
    "ranges": {
      "u_density": [0.2, 3]
    }
  },
