[
  {
    "id": "hero-torus-knot",
    "name": "Iridescent Torus Knot Hero",
    "category": "Surfaces & PBR",
    "description": "Procedural thin-film iridescent chrome Torus Knot with Fresnel rim glow, audio pulsation, and Blinn-Phong specular highlights.",
    "backend": "threejs",
    "geometry": "torus_knot",
    "glsl": [
      "#version 300 es",
      "precision highp float;",
      "",
      "in vec3 v_world_pos;",
      "out vec4 fragColor;",
      "",
      "uniform float u_time;",
      "uniform vec3 u_color;",
      "uniform float u_fresnelPower;",
      "uniform float u_iridescence;",
      "uniform float u_roughness;",
      "uniform float u_pulseSpeed;",
      "uniform float u_audio_bass;",
      "uniform float u_audio_mid;",
      "uniform float u_audio_treble;",
      "uniform float u_audio_beat;",
      "",
      "// Inigo Quilez spectral rainbow palette",
      "vec3 palette(float t) {",
      "    vec3 a = vec3(0.5, 0.5, 0.5);",
      "    vec3 b = vec3(0.5, 0.5, 0.5);",
      "    vec3 c = vec3(1.0, 1.0, 1.0);",
      "    vec3 d = vec3(0.0, 0.33, 0.67);",
      "    return a + b * cos(6.28318 * (c * t + d));",
      "}",
      "",
      "void main() {",
      "    // Screen-space surface normal (the vertex stream is position-only)",
      "    vec3 crossNorm = cross(dFdx(v_world_pos), dFdy(v_world_pos));",
      "    vec3 normal = length(crossNorm) > 0.00001 ? normalize(crossNorm) : vec3(0.0, 1.0, 0.0);",
      "",
      "    vec3 viewDir = normalize(vec3(0.0, 2.0, 4.0) - v_world_pos);",
      "    if (dot(normal, viewDir) < 0.0) {",
      "        normal = -normal;",
      "    }",
      "    vec3 lightDir = normalize(vec3(1.0, 2.0, 1.5));",
      "    vec3 halfVec = normalize(lightDir + viewDir);",
      "",
      "    float NdotV = clamp(dot(normal, viewDir), 0.0, 1.0);",
      "    float fresnel = pow(clamp(1.0 - NdotV, 0.0, 1.0), max(0.1, u_fresnelPower));",
      "",
      "    float NdotH = clamp(dot(normal, halfVec), 0.0, 1.0);",
      "    float shininess = mix(128.0, 8.0, clamp(u_roughness, 0.0, 1.0));",
      "    float spec = pow(NdotH, shininess);",
      "",
      "    float wavePhase = u_time * u_pulseSpeed * 0.5 + v_world_pos.y * 2.0;",
      "    float thinFilm = pow(clamp(1.0 - NdotV, 0.0, 1.0), 2.0) + sin(wavePhase) * 0.15 + u_audio_mid * 0.3;",
      "    vec3 iridescentCol = palette(thinFilm * u_iridescence);",
      "",
      "    float diff = max(0.25, dot(normal, lightDir) * 0.55 + 0.45);",
      "",
      "    vec3 base = u_color * diff;",
      "    float audioBoost = 1.0 + u_audio_beat * 0.5;",
      "    vec3 rgb = (mix(base, iridescentCol, 0.65) + vec3(spec * 1.8) + iridescentCol * fresnel * 1.6) * audioBoost;",
      "",
      "    fragColor = vec4(rgb, 1.0);",
      "}"
    ],
    "wgsl": [
      "struct Uniforms {",
      "  mvp: mat4x4<f32>,",
      "  u_color: vec3<f32>,",
      "  u_time: f32,",
      "  u_fresnelPower: f32,",
      "  u_iridescence: f32,",
      "  u_roughness: f32,",
      "  u_pulseSpeed: f32,",
      "  u_audio_bass: f32,",
      "  u_audio_mid: f32,",
      "  u_audio_treble: f32,",
      "  u_audio_beat: f32,",
      "}",
      "",
      "@group(0) @binding(0) var<uniform> uniforms: Uniforms;",
      "",
      "struct VertexInput {",
      "  @location(0) position: vec3<f32>,",
      "}",
      "",
      "struct VertexOutput {",
      "  @builtin(position) clip_position: vec4<f32>,",
      "  @location(0) world_pos: vec3<f32>,",
      "}",
      "",
      "@vertex",
      "fn vertex_main(input: VertexInput) -> VertexOutput {",
      "  var output: VertexOutput;",
      "  // Audio-reactive procedural vertex breathing",
      "  let pulse = sin(uniforms.u_time * uniforms.u_pulseSpeed * 2.0) * 0.04 * (1.0 + uniforms.u_audio_bass * 1.8);",
      "  let displacedPos = input.position * (1.0 + pulse);",
      "  output.clip_position = uniforms.mvp * vec4<f32>(displacedPos, 1.0);",
      "  output.world_pos = displacedPos;",
      "  return output;",
      "}",
      "",
      "// Inigo Quilez spectral rainbow palette",
      "fn palette(t: f32) -> vec3<f32> {",
      "  let a = vec3<f32>(0.5, 0.5, 0.5);",
      "  let b = vec3<f32>(0.5, 0.5, 0.5);",
      "  let c = vec3<f32>(1.0, 1.0, 1.0);",
      "  let d = vec3<f32>(0.0, 0.33, 0.67);",
      "  return a + b * cos(6.28318 * (c * t + d));",
      "}",
      "",
      "@fragment",
      "fn fragment_main(input: VertexOutput) -> @location(0) vec4<f32> {",
      "  // Screen-space surface normal (the vertex stream is position-only)",
      "  let crossNorm = cross(dpdx(input.world_pos), dpdy(input.world_pos));",
      "  var normal = select(vec3<f32>(0.0, 1.0, 0.0), normalize(crossNorm), length(crossNorm) > 0.00001);",
      "",
      "  let viewDir = normalize(vec3<f32>(0.0, 2.0, 4.0) - input.world_pos);",
      "  if (dot(normal, viewDir) < 0.0) {",
      "    normal = -normal;",
      "  }",
      "  let lightDir = normalize(vec3<f32>(1.0, 2.0, 1.5));",
      "  let halfVec = normalize(lightDir + viewDir);",
      "",
      "  let NdotV = clamp(dot(normal, viewDir), 0.0, 1.0);",
      "  let fresnel = pow(clamp(1.0 - NdotV, 0.0, 1.0), max(0.1, uniforms.u_fresnelPower));",
      "",
      "  let NdotH = clamp(dot(normal, halfVec), 0.0, 1.0);",
      "  let shininess = mix(128.0, 8.0, clamp(uniforms.u_roughness, 0.0, 1.0));",
      "  let spec = pow(NdotH, shininess);",
      "",
      "  let wavePhase = uniforms.u_time * uniforms.u_pulseSpeed * 0.5 + input.world_pos.y * 2.0;",
      "  let thinFilm = pow(clamp(1.0 - NdotV, 0.0, 1.0), 2.0) + sin(wavePhase) * 0.15 + uniforms.u_audio_mid * 0.3;",
      "  let iridescentCol = palette(thinFilm * uniforms.u_iridescence);",
      "",
      "  let diff = max(0.25, dot(normal, lightDir) * 0.55 + 0.45);",
      "",
      "  let base = uniforms.u_color * diff;",
      "  let audioBoost = 1.0 + uniforms.u_audio_beat * 0.5;",
      "  let rgb = (mix(base, iridescentCol, 0.65) + vec3<f32>(spec * 1.8) + iridescentCol * fresnel * 1.6) * audioBoost;",
      "",
      "  return vec4<f32>(rgb, 1.0);",
      "}"
    ],
    "uniforms": {
      "u_color": { "type": "color", "value": [0.1, 0.75, 1] },
      "u_fresnelPower": { "type": "float", "value": 2.8 },
      "u_iridescence": { "type": "float", "value": 1.6 },
      "u_roughness": { "type": "float", "value": 0.2 },
      "u_pulseSpeed": { "type": "float", "value": 1.5 }
    },
    "ranges": {
      "u_fresnelPower": [0.5, 8],
      "u_iridescence": [0, 4],
      "u_roughness": [0, 1],
      "u_pulseSpeed": [0, 6]
    }
  },
  {
    "id": "holographic-shield",
    "name": "Holographic Energy Shield",
    "category": "Sci-Fi & VFX",
    "description": "Hexagonal energy barrier with animated scanlines, edge Fresnel emission, and chromatic aberration.",
    "backend": "threejs",
    "geometry": "sphere",
    "glsl": [
      "#version 300 es",
      "precision highp float;",
      "",
      "in vec3 v_world_pos;",
      "out vec4 fragColor;",
      "",
      "uniform float u_time;",
      "uniform vec3 u_shieldColor;",
      "uniform float u_fresnelPower;",
      "uniform float u_scanlineSpeed;",
      "uniform float u_hexScale;",
      "",
      "// Hexagonal tiling pattern",
      "float hexPattern(vec2 p) {",
      "    p *= u_hexScale;",
      "    vec2 q = vec2(p.x * 2.0 / sqrt(3.0), p.y + p.x / sqrt(3.0));",
      "    vec2 pf = fract(q);",
      "    float v = min(min(pf.x, 1.0 - pf.x), min(pf.y, 1.0 - pf.y));",
      "    return smoothstep(0.0, 0.08, v);",
      "}",
      "",
      "void main() {",
      "    vec3 p = v_world_pos;",
      "    vec3 normal = normalize(p);",
      "    vec3 viewDir = normalize(vec3(0.0, 2.0, 4.0) - p);",
      "    vec2 uv = vec2(atan(p.z, p.x) / 6.2831853 + 0.5, p.y * 0.5 + 0.5);",
      "",
      "    // 1. View angle Fresnel glow",
      "    float fresnel = pow(clamp(1.0 - dot(normal, viewDir), 0.0, 1.0), max(0.1, u_fresnelPower));",
      "",
      "    // 2. Animated vertical scanlines",
      "    float scanline = sin(uv.y * 60.0 - u_time * u_scanlineSpeed) * 0.5 + 0.5;",
      "",
      "    // 3. Hexagonal energy grid",
      "    float hex = 1.0 - hexPattern(uv);",
      "",
      "    // 4. Energy pulse combination",
      "    float pulse = sin(u_time * 2.0) * 0.2 + 0.8;",
      "    vec3 finalColor = u_shieldColor * (fresnel * 1.5 + hex * 0.8 + scanline * 0.3) * pulse;",
      "    float alpha = clamp(fresnel * 0.8 + hex * 0.6 + scanline * 0.2, 0.1, 0.95);",
      "",
      "    // Premultiplied translucency over the dark scene (identical on every backend)",
      "    fragColor = vec4(finalColor * alpha, 1.0);",
      "}"
    ],
    "wgsl": [
      "struct Uniforms {",
      "  mvp: mat4x4<f32>,",
      "  u_shieldColor: vec3<f32>,",
      "  u_time: f32,",
      "  u_fresnelPower: f32,",
      "  u_scanlineSpeed: f32,",
      "  u_hexScale: f32,",
      "}",
      "",
      "@group(0) @binding(0) var<uniform> uniforms: Uniforms;",
      "",
      "struct VertexInput {",
      "  @location(0) position: vec3<f32>,",
      "}",
      "",
      "struct VertexOutput {",
      "  @builtin(position) clip_position: vec4<f32>,",
      "  @location(0) world_pos: vec3<f32>,",
      "}",
      "",
      "@vertex",
      "fn vertex_main(input: VertexInput) -> VertexOutput {",
      "  var output: VertexOutput;",
      "  output.clip_position = uniforms.mvp * vec4<f32>(input.position, 1.0);",
      "  output.world_pos = input.position;",
      "  return output;",
      "}",
      "",
      "// Hexagonal tiling pattern",
      "fn hexPattern(uv: vec2<f32>) -> f32 {",
      "  let p = uv * uniforms.u_hexScale;",
      "  let q = vec2<f32>(p.x * 2.0 / sqrt(3.0), p.y + p.x / sqrt(3.0));",
      "  let pf = fract(q);",
      "  let v = min(min(pf.x, 1.0 - pf.x), min(pf.y, 1.0 - pf.y));",
      "  return smoothstep(0.0, 0.08, v);",
      "}",
      "",
      "@fragment",
      "fn fragment_main(input: VertexOutput) -> @location(0) vec4<f32> {",
      "  let p = input.world_pos;",
      "  let normal = normalize(p);",
      "  let viewDir = normalize(vec3<f32>(0.0, 2.0, 4.0) - p);",
      "  let uv = vec2<f32>(atan2(p.z, p.x) / 6.2831853 + 0.5, p.y * 0.5 + 0.5);",
      "",
      "  // 1. View angle Fresnel glow",
      "  let fresnel = pow(clamp(1.0 - dot(normal, viewDir), 0.0, 1.0), max(0.1, uniforms.u_fresnelPower));",
      "",
      "  // 2. Animated vertical scanlines",
      "  let scanline = sin(uv.y * 60.0 - uniforms.u_time * uniforms.u_scanlineSpeed) * 0.5 + 0.5;",
      "",
      "  // 3. Hexagonal energy grid",
      "  let hex = 1.0 - hexPattern(uv);",
      "",
      "  // 4. Energy pulse combination",
      "  let pulse = sin(uniforms.u_time * 2.0) * 0.2 + 0.8;",
      "  let finalColor = uniforms.u_shieldColor * (fresnel * 1.5 + hex * 0.8 + scanline * 0.3) * pulse;",
      "  let alpha = clamp(fresnel * 0.8 + hex * 0.6 + scanline * 0.2, 0.1, 0.95);",
      "",
      "  // Premultiplied translucency over the dark scene (identical on every backend)",
      "  return vec4<f32>(finalColor * alpha, 1.0);",
      "}"
    ],
    "uniforms": {
      "u_shieldColor": { "type": "color", "value": [0, 0.85, 1] },
      "u_fresnelPower": { "type": "float", "value": 2.5 },
      "u_scanlineSpeed": { "type": "float", "value": 4 },
      "u_hexScale": { "type": "float", "value": 12 }
    },
    "ranges": {
      "u_fresnelPower": [0.5, 8],
      "u_scanlineSpeed": [0, 12],
      "u_hexScale": [2, 40]
    }
  },
  {
    "id": "solar-plasma-orb",
    "name": "Boiling Solar Plasma Orb",
    "category": "Atmospheric",
    "description": "Turbulent multi-octave FBM convective plasma cells with coronal flares and high-temperature radiation.",
    "backend": "threejs",
    "geometry": "sphere",
    "glsl": [
      "#version 300 es",
      "precision highp float;",
      "",
      "in vec3 v_world_pos;",
      "out vec4 fragColor;",
      "",
      "uniform float u_time;",
      "uniform vec3 u_plasmaColor;",
      "uniform float u_plasmaSpeed;",
      "uniform float u_turbulence;",
      "",
      "float hash(vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453123); }",
      "",
      "float noise(vec2 p) {",
      "    vec2 i = floor(p);",
      "    vec2 f = fract(p);",
      "    vec2 u = f * f * (3.0 - 2.0 * f);",
      "    return mix(mix(hash(i + vec2(0.0, 0.0)), hash(i + vec2(1.0, 0.0)), u.x),",
      "               mix(hash(i + vec2(0.0, 1.0)), hash(i + vec2(1.0, 1.0)), u.x), u.y);",
      "}",
      "",
      "float fbm(vec2 p) {",
      "    float v = 0.0;",
      "    float a = 0.5;",
      "    mat2 rot = mat2(0.8, -0.6, 0.6, 0.8);",
      "    for (int i = 0; i < 4; i++) {",
      "        v += a * noise(p);",
      "        p = rot * p * 2.0 + vec2(100.0);",
      "        a *= 0.5;",
      "    }",
      "    return v;",
      "}",
      "",
      "void main() {",
      "    vec3 pos = v_world_pos;",
      "    vec3 normal = normalize(pos);",
      "    vec3 viewDir = normalize(vec3(0.0, 2.0, 4.0) - pos);",
      "    vec2 uv = vec2(atan(pos.z, pos.x) / 6.2831853 + 0.5, pos.y * 0.5 + 0.5) * 4.0;",
      "    float t = u_time * u_plasmaSpeed;",
      "",
      "    // Dual-layer domain warping",
      "    vec2 q = vec2(fbm(uv + vec2(0.0, t * 0.2)), fbm(uv + vec2(5.2, 1.3)));",
      "    vec2 r = vec2(fbm(uv + 4.0 * q + vec2(1.7, 9.2) + 0.15 * t), fbm(uv + 4.0 * q + vec2(8.3, 2.8) + 0.126 * t));",
      "    float f = fbm(uv + 4.0 * r * u_turbulence);",
      "",
      "    // Color gradient mapping",
      "    vec3 colA = vec3(0.1, 0.0, 0.0);",
      "    vec3 colB = u_plasmaColor;",
      "    vec3 colC = vec3(1.0, 0.95, 0.7);",
      "",
      "    vec3 color = mix(colA, colB, clamp(f * f * 4.0, 0.0, 1.0));",
      "    color = mix(color, colC, clamp(length(q) * f, 0.0, 1.0));",
      "",
      "    // Corona rim glow",
      "    float rim = 1.0 - clamp(dot(normal, viewDir), 0.0, 1.0);",
      "    color += u_plasmaColor * pow(rim, 3.0) * 2.0;",
      "",
      "    fragColor = vec4(color, 1.0);",
      "}"
    ],
    "wgsl": [
      "struct Uniforms {",
      "  mvp: mat4x4<f32>,",
      "  u_plasmaColor: vec3<f32>,",
      "  u_time: f32,",
      "  u_plasmaSpeed: f32,",
      "  u_turbulence: f32,",
      "}",
      "",
      "@group(0) @binding(0) var<uniform> uniforms: Uniforms;",
      "",
      "struct VertexInput {",
      "  @location(0) position: vec3<f32>,",
      "}",
      "",
      "struct VertexOutput {",
      "  @builtin(position) clip_position: vec4<f32>,",
      "  @location(0) world_pos: vec3<f32>,",
      "}",
      "",
      "@vertex",
      "fn vertex_main(input: VertexInput) -> VertexOutput {",
      "  var output: VertexOutput;",
      "  output.clip_position = uniforms.mvp * vec4<f32>(input.position, 1.0);",
      "  output.world_pos = input.position;",
      "  return output;",
      "}",
      "",
      "fn hash(p: vec2<f32>) -> f32 {",
      "  return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453123);",
      "}",
      "",
      "fn noise(p: vec2<f32>) -> f32 {",
      "  let i = floor(p);",
      "  let f = fract(p);",
      "  let u = f * f * (3.0 - 2.0 * f);",
      "  return mix(",
      "    mix(hash(i + vec2<f32>(0.0, 0.0)), hash(i + vec2<f32>(1.0, 0.0)), u.x),",
      "    mix(hash(i + vec2<f32>(0.0, 1.0)), hash(i + vec2<f32>(1.0, 1.0)), u.x),",
      "    u.y);",
      "}",
      "",
      "fn fbm(p0: vec2<f32>) -> f32 {",
      "  var p = p0;",
      "  var v = 0.0;",
      "  var a = 0.5;",
      "  let rot = mat2x2<f32>(0.8, -0.6, 0.6, 0.8);",
      "  for (var i = 0; i < 4; i++) {",
      "    v += a * noise(p);",
      "    p = rot * p * 2.0 + vec2<f32>(100.0);",
      "    a *= 0.5;",
      "  }",
      "  return v;",
      "}",
      "",
      "@fragment",
      "fn fragment_main(input: VertexOutput) -> @location(0) vec4<f32> {",
      "  let pos = input.world_pos;",
      "  let normal = normalize(pos);",
      "  let viewDir = normalize(vec3<f32>(0.0, 2.0, 4.0) - pos);",
      "  let uv = vec2<f32>(atan2(pos.z, pos.x) / 6.2831853 + 0.5, pos.y * 0.5 + 0.5) * 4.0;",
      "  let t = uniforms.u_time * uniforms.u_plasmaSpeed;",
      "",
      "  // Dual-layer domain warping",
      "  let q = vec2<f32>(fbm(uv + vec2<f32>(0.0, t * 0.2)), fbm(uv + vec2<f32>(5.2, 1.3)));",
      "  let r = vec2<f32>(fbm(uv + 4.0 * q + vec2<f32>(1.7, 9.2) + 0.15 * t), fbm(uv + 4.0 * q + vec2<f32>(8.3, 2.8) + 0.126 * t));",
      "  let f = fbm(uv + 4.0 * r * uniforms.u_turbulence);",
      "",
      "  // Color gradient mapping",
      "  let colA = vec3<f32>(0.1, 0.0, 0.0);",
      "  let colB = uniforms.u_plasmaColor;",
      "  let colC = vec3<f32>(1.0, 0.95, 0.7);",
      "",
      "  var color = mix(colA, colB, clamp(f * f * 4.0, 0.0, 1.0));",
      "  color = mix(color, colC, clamp(length(q) * f, 0.0, 1.0));",
      "",
      "  // Corona rim glow",
      "  let rim = 1.0 - clamp(dot(normal, viewDir), 0.0, 1.0);",
      "  color = color + uniforms.u_plasmaColor * pow(rim, 3.0) * 2.0;",
      "",
      "  return vec4<f32>(color, 1.0);",
      "}"
    ],
    "uniforms": {
      "u_plasmaColor": { "type": "color", "value": [1, 0.35, 0.05] },
      "u_plasmaSpeed": { "type": "float", "value": 0.8 },
      "u_turbulence": { "type": "float", "value": 1.2 }
    },
    "ranges": {
      "u_plasmaSpeed": [0, 4],
      "u_turbulence": [0.2, 3]
    }
  },
  {
    "id": "synthwave-grid",
    "name": "Cyberpunk Synthwave Grid",
    "category": "Retro & Stylized",
    "description": "Retro 80s endless perspective neon grid with glowing horizon sun and atmospheric fog.",
    "backend": "threejs",
    "geometry": "plane",
    "glsl": [
      "#version 300 es",
      "precision highp float;",
      "",
      "in vec3 v_world_pos;",
      "out vec4 fragColor;",
      "",
      "uniform float u_time;",
      "uniform vec3 u_gridColor;",
      "uniform vec3 u_sunColor;",
      "uniform float u_speed;",
      "",
      "// Plane coordinates in [-1, 1] with +y up (handles both XY and XZ plane meshes)",
      "vec2 planeUv(vec3 p) {",
      "    float v = abs(p.z) > 0.0001 ? -p.z : p.y;",
      "    return vec2(p.x, v);",
      "}",
      "",
      "void main() {",
      "    vec2 uv = planeUv(v_world_pos);",
      "    float horizon = -0.1;",
      "",
      "    // Perspective ground projection (derivatives are taken outside any branch)",
      "    float depth = 1.0 / max(horizon - uv.y, 0.001);",
      "    vec2 gridUv = vec2(uv.x * depth, depth - u_time * u_speed);",
      "    vec2 fw = max(fwidth(gridUv), vec2(0.0001));",
      "    vec2 grid = abs(fract(gridUv - 0.5) - 0.5) / fw;",
      "    float line = min(grid.x, grid.y);",
      "    float gridIntensity = 1.0 - min(line, 1.0);",
      "    float fog = exp(-depth * 0.15);",
      "",
      "    vec3 finalColor = vec3(0.02, 0.01, 0.06);",
      "",
      "    if (uv.y < horizon) {",
      "        finalColor += u_gridColor * gridIntensity * fog;",
